# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google Places API (required for us-pipeline.js)
# Get at: https://console.cloud.google.com/ → APIs & Services → Enable "Places API"
# Free tier: $200/mo credit. Full US pipeline costs ~$70 in API usage.
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_NAME=ClimateFlow AI
FROM_EMAIL=your_email@gmail.com

# Outreach settings
DAILY_SEND_LIMIT=50
DELAY_BETWEEN_EMAILS_MS=30000

# CAN-SPAM compliance (required — the sender will refuse to start without these)
# UNSUBSCRIBE_MAILTO: a mailbox YOU monitor. Replies here must be honored within 10 business days.
# PHYSICAL_ADDRESS:   valid postal address of the sender (can be a PO box or virtual mailbox).
# UNSUBSCRIBE_URL:    optional one-click opt-out endpoint. Gmail/Yahoo prefer this.
UNSUBSCRIBE_MAILTO=unsubscribe@yourdomain.com
PHYSICAL_ADDRESS=ClimateFlow AI, 123 Main St Suite 100, Portland, OR 97201
UNSUBSCRIBE_URL=
