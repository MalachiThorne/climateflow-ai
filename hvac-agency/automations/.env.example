# ============================================================
# ClimateFlow AI — Automation Server
# Copy to .env and fill in values before running locally.
# All vars marked REQUIRED must be set for the server to work.
# ============================================================

# --- Twilio (REQUIRED) ---
# From console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx   # Your default/fallback Twilio number

# --- Anthropic / Claude (REQUIRED) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Stripe (REQUIRED for billing) ---
# From dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Webhook secret — from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Per-plan Stripe price IDs — create each as a recurring monthly price in the Stripe Dashboard.
# STRIPE_PRICE_ID_BUNDLE is the $2,500/month full bundle and is the fallback for STRIPE_PRICE_ID.
STRIPE_PRICE_ID=price_...                           # DEPRECATED — bundle fallback; prefer STRIPE_PRICE_ID_BUNDLE
STRIPE_PRICE_ID_BUNDLE=price_...                    # $2,500/month — all three services
STRIPE_PRICE_ID_LEAD_RESCUE=price_...               # $1,500/month — Lead Rescue only
STRIPE_PRICE_ID_REVIEW_AUTOPILOT=price_...          # $500/month — Review Autopilot only
STRIPE_PRICE_ID_ESTIMATE_FOLLOWUP=price_...         # $1,000/month — Estimate Follow-Up only

# --- Google Calendar OAuth (REQUIRED for calendar booking) ---
# From console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=https://your-railway-domain.up.railway.app/api/calendar/callback

# --- Database (REQUIRED) ---
# Railway auto-sets this if you add a Postgres plugin.
# For local dev with docker-compose, use:
#   postgresql://climateflow:climateflow@localhost:5432/climateflow
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Email / SMTP (REQUIRED for welcome and billing emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
FROM_EMAIL=support@climateflow.ai
FROM_NAME=ClimateFlow AI

# --- Server (REQUIRED) ---
PORT=3001
# Full public URL of this server — used for Twilio webhook URLs and email links
WEBHOOK_BASE_URL=https://your-railway-domain.up.railway.app
NODE_ENV=production

# --- API Key (REQUIRED) ---
# Protects all /api/* admin endpoints.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=your_64_char_hex_api_key

# --- Token Encryption (REQUIRED) ---
# Encrypts Google OAuth tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your_64_char_hex_encryption_key

# --- URL Signing (REQUIRED) ---
# Secret used to HMAC-sign billing + calendar connect + verification URLs.
# Must be at least 32 chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
URL_SIGNING_SECRET=your_64_char_hex_signing_secret

# --- Landing Page (set in landing-page/.env.local) ---
# NEXT_PUBLIC_SIGNUP_URL=https://your-railway-domain.up.railway.app/signup
